#!/usr/bin/env bash
# Turns this laptop into an unprovisioned Teton device for a demo (SPEC.md §12):
#   - remembers which saved Wi-Fi profiles autoconnect, and turns that off
#   - deletes earlier teton-provisioned profiles
#   - disconnects Wi-Fi
# Nothing of yours is deleted; scripts/demo-restore undoes it. Safe to re-run:
# an interrupted run resumes, adding to the same restore list.
# Usage: scripts/demo-prep [--dry-run]
set -euo pipefail

dry=false
[ "${1:-}" = "--dry-run" ] && dry=true
run() { if $dry; then echo "would run: $*"; else "$@"; fi; }

state="${XDG_STATE_HOME:-$HOME/.local/state}/teton-demo"
saved="$state/autoconnect.txt"
iface=$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "wifi" { print $1; exit }')
[ -n "$iface" ] || { echo "No Wi-Fi device found." >&2; exit 1; }
$dry || mkdir -p "$state"

# -t escapes ':' inside names as '\:'; NAME is last, so it may contain them.
mapfile -t todo < <(nmcli -t -f UUID,TYPE,AUTOCONNECT,NAME connection show |
  awk -F: '$2 == "802-11-wireless" && ($3 == "yes" || $4 ~ /^teton-provisioned/)')

# Each change is written through netplan on Ubuntu 24.04 (about 1.5 s each).
echo "Updating ${#todo[@]} Wi-Fi profiles; this takes about $(( (${#todo[@]} * 3 + 1) / 2 )) s..."
n=0
for line in "${todo[@]}"; do
  IFS=: read -r uuid _ _ name <<< "$line"
  n=$((n + 1))
  case "$name" in
    teton-provisioned*)
      echo "[$n/${#todo[@]}] deleting earlier profile: $name"
      run nmcli connection delete "$uuid" > /dev/null
      ;;
    *)
      echo "[$n/${#todo[@]}] autoconnect off: $name"
      # Record before changing, so an interrupted run never loses a profile.
      $dry || echo "$uuid" >> "$saved"
      run nmcli connection modify "$uuid" connection.autoconnect no
      ;;
  esac
done

run nmcli device disconnect "$iface" > /dev/null
if $dry; then
  echo "(dry run: nothing changed)"
else
  echo "Done: Wi-Fi on $iface is disconnected and won't reconnect by itself."
  echo "Undo with scripts/demo-restore."
fi
